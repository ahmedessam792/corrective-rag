CRAG_DATA_DIR=.data
CRAG_RUNTIME=deterministic
CRAG_OLLAMA_URL=http://127.0.0.1:11434
CRAG_CHAT_MODEL=qwen3.5:4b-q4_K_M
CRAG_EMBED_MODEL=qwen3-embedding:0.6b
CRAG_OLLAMA_CONTEXT_SIZE=8192
CRAG_OLLAMA_OUTPUT_TOKENS=1024
CRAG_OLLAMA_SEED=42
CRAG_OLLAMA_GPU_LAYERS=-1
CRAG_OLLAMA_KEEP_ALIVE=10m
CRAG_OLLAMA_TIMEOUT_SECONDS=180
CRAG_STRUCTURED_REPAIR_ATTEMPTS=1
CRAG_MAX_UPLOAD_MB=50
CRAG_MAX_CORRECTIONS=1
CRAG_CONTEXT_CHUNKS=6
CRAG_FRONTEND_ORIGIN=http://localhost:5173
